{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pactia",
  "scopeName": "source.pactia",
  "patterns": [
    { "include": "#comments" },
    { "include": "#interpolation" },
    { "include": "#multiline-prose" },
    { "include": "#prose-lines" },
    { "include": "#strings" },
    { "include": "#qualified-references" },
    { "include": "#package-imports" },
    { "include": "#inline-tag-modifiers" },
    { "include": "#inline-objects" },
    { "include": "#modifier-tag-lines" },
    { "include": "#modifier-tags" },
    { "include": "#modifier-shorthands" },
    { "include": "#modifier-flags" },
    { "include": "#host-tag-prefix" },
    { "include": "#macros" },
    { "include": "#def-declarations" },
    { "include": "#context-declarations" },
    { "include": "#context-constants" },
    { "include": "#module-constants" },
    { "include": "#def-field-specs" },
    { "include": "#single-line-tag-blocks" },
    { "include": "#attach-references" },
    { "include": "#export-blocks" },
    { "include": "#multiline-blocks" },
    { "include": "#keywords" },
    { "include": "#assignment-keys" },
    { "include": "#types" },
    { "include": "#numbers" }
  ],
  "repository": {
    "block-content": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#interpolation" },
        { "include": "#multiline-prose" },
        { "include": "#prose-lines" },
        { "include": "#strings" },
        { "include": "#qualified-references" },
        { "include": "#package-imports" },
        { "include": "#inline-tag-modifiers" },
        { "include": "#inline-objects" },
        { "include": "#object-value-blocks" },
        { "include": "#modifier-tag-lines" },
        { "include": "#modifier-tags" },
        { "include": "#modifier-shorthands" },
        { "include": "#modifier-flags" },
        { "include": "#host-tag-prefix" },
        { "include": "#macros" },
        { "include": "#def-declarations" },
        { "include": "#context-declarations" },
        { "include": "#context-constants" },
        { "include": "#module-constants" },
        { "include": "#def-field-specs" },
        { "include": "#single-line-tag-blocks" },
        { "include": "#attach-references" },
        { "include": "#export-blocks" },
        { "include": "#multiline-blocks" },
        { "include": "#keywords" },
        { "include": "#assignment-keys" },
        { "include": "#types" },
        { "include": "#numbers" }
      ]
    },
    "inline-object-content": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#interpolation" },
        { "include": "#strings" },
        { "include": "#qualified-references" },
        { "include": "#package-imports" },
        { "include": "#keywords" },
        { "include": "#assignment-keys" },
        { "include": "#types" },
        { "include": "#numbers" }
      ]
    },
    "inline-block-content": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#interpolation" },
        { "include": "#inline-prose" },
        { "include": "#strings" },
        { "include": "#qualified-references" },
        { "include": "#package-imports" },
        { "include": "#keywords" },
        { "include": "#assignment-keys" },
        { "include": "#types" },
        { "include": "#numbers" }
      ]
    },
    "inline-prose": {
      "begin": "(>\\s*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.prose.quote.pactia punctuation.definition.blockquote" }
      },
      "end": "(?=\\s*\\})",
      "patterns": [
        { "include": "#interpolation" },
        {
          "match": "[^}]+?(?=\\s*\\})",
          "name": "string.unquoted.prose.pactia string.quoted.other markup.italic"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.pactia",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.pactia",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.pactia",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#interpolation" },
        {
          "name": "constant.character.escape.pactia",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "match": "(\\$\\{)([\\w]+)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.interpolation.pactia" },
            "2": { "name": "variable.other.interpolation.pactia" },
            "3": { "name": "punctuation.definition.interpolation.pactia" }
          }
        }
      ]
    },
    "multiline-prose": {
      "begin": "^(\\s*)(>>)\\s*",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.prose.quote.pactia punctuation.definition.blockquote" }
      },
      "end": "(>>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.prose.quote.pactia punctuation.definition.blockquote" }
      },
      "contentName": "string.unquoted.prose.pactia",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "qualified-references": {
      "patterns": [
        {
          "match": "(@)([\\w]+)(::)([\\w]+)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.namespace.pactia" },
            "3": { "name": "punctuation.separator.namespace.pactia" },
            "4": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function" }
          }
        }
      ]
    },
    "single-line-tag-blocks": {
      "patterns": [
        {
          "match": "^(\\s*)(@)(?:(\\w+)::)?(\\w+)(?:\\s+([\\w.-]+))?\\s*(\\{)\\s*(\\})\\s*$",
          "captures": {
            "2": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "3": { "name": "entity.name.namespace.pactia" },
            "4": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function" },
            "5": { "name": "entity.name.tag.target.pactia" },
            "6": { "name": "punctuation.section.block.begin.pactia" },
            "7": { "name": "punctuation.section.block.end.pactia" }
          }
        }
      ]
    },
    "attach-references": {
      "patterns": [
        {
          "match": "^(\\s*)(model)\\s*\\((\\w+)\\)\\s*,?\\s*$",
          "captures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "entity.name.type.pactia" }
          }
        },
        {
          "match": "^(\\s*)(context)\\s*\\((\\w+)\\)\\s*,?\\s*$",
          "captures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "entity.name.context.pactia" }
          }
        }
      ]
    },
    "multiline-blocks": {
      "begin": "^(\\s*)(?:(product)\\s+(\\w+)|(module)\\s*(?:\\((\\w+)\\)|(\\w+))|(service)\\s*(?:\\((\\w+)\\)|(\\w+))|(model)|(@)(?:(\\w+)::)?(\\w+)(?:\\s+([\\w.-]+))?)\\s*\\{\\s*$",
      "beginCaptures": {
        "2": { "name": "keyword.declaration.pactia" },
        "3": { "name": "entity.name.type.pactia" },
        "4": { "name": "keyword.declaration.pactia" },
        "5": { "name": "entity.name.type.pactia" },
        "6": { "name": "entity.name.type.pactia" },
        "7": { "name": "keyword.declaration.pactia" },
        "8": { "name": "entity.name.type.pactia" },
        "9": { "name": "entity.name.type.pactia" },
        "10": { "name": "keyword.declaration.pactia" },
        "11": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
        "12": { "name": "entity.name.namespace.pactia" },
        "13": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function" },
        "14": { "name": "entity.name.tag.target.pactia" }
      },
      "end": "^(\\1)\\}(?:,)?\\s*$",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.pactia" }
      },
      "patterns": [
        { "include": "#block-content" }
      ]
    },
    "context-declarations": {
      "patterns": [
        {
          "begin": "^(\\s*)(?:(export)\\s+)?(context)\\s+(\\w+)\\s*\\{\\s*$",
          "beginCaptures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "keyword.declaration.pactia" },
            "4": { "name": "entity.name.context.pactia" }
          },
          "end": "^(\\1)\\}(?:,)?\\s*$",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#block-content" }
          ]
        }
      ]
    },
    "context-constants": {
      "patterns": [
        {
          "begin": "^(\\s*)(def)\\s+([\\w]+)\\s*(=)\\s*(context)\\s+(\\w+)\\s*\\{\\s*$",
          "beginCaptures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "variable.other.constant.pactia" },
            "4": { "name": "keyword.operator.assignment.pactia" },
            "5": { "name": "keyword.declaration.pactia" },
            "6": { "name": "entity.name.context.pactia" }
          },
          "end": "^(\\1)\\}(?:,)?\\s*$",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#block-content" }
          ]
        }
      ]
    },
    "def-declarations": {
      "patterns": [
        {
          "begin": "^(\\s*)(?:(export)\\s+)?(def)\\s+(@@|@|#)([\\w]+)(?:\\([^)]*\\))?(?:\\s+(in)\\s+((?:product|module|model|service|field)(?:\\s*,\\s*(?:product|module|model|service|field))*))?\\s*\\{\\s*$",
          "beginCaptures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "keyword.declaration.pactia" },
            "4": { "name": "punctuation.definition.def-sigil.pactia" },
            "5": { "name": "entity.name.tag.def.pactia entity.name.function.macro.pactia entity.name.function" },
            "6": { "name": "keyword.declaration.pactia" },
            "7": { "name": "constant.language.placement.pactia" }
          },
          "end": "^(\\1)\\}(?:,)?\\s*$",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#block-content" }
          ]
        }
      ]
    },
    "module-constants": {
      "patterns": [
        {
          "match": "^(\\s*)((?:export)\\s+)?(def)\\s+([\\w]+)\\s*(=)\\s*(>\\s*)(.+)$",
          "captures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "keyword.declaration.pactia" },
            "4": { "name": "variable.other.constant.pactia" },
            "5": { "name": "keyword.operator.assignment.pactia" },
            "6": { "name": "punctuation.definition.prose.quote.pactia punctuation.definition.blockquote" },
            "7": { "name": "string.unquoted.prose.pactia string.quoted.other markup.italic" }
          }
        },
        {
          "match": "^(\\s*)((?:export)\\s+)?(def)\\s+([\\w]+)\\s*(=)\\s*(\"(?:[^\"\\\\]|\\\\.)*\")\\s*$",
          "captures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "keyword.declaration.pactia" },
            "4": { "name": "variable.other.constant.pactia" },
            "5": { "name": "keyword.operator.assignment.pactia" },
            "6": { "name": "string.quoted.double.pactia" }
          }
        },
        {
          "match": "^(\\s*)((?:export)\\s+)?(def)\\s+([\\w]+)\\s*(=)\\s*(-?\\d+(?:\\.\\d+)?)\\s*$",
          "captures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "keyword.declaration.pactia" },
            "4": { "name": "variable.other.constant.pactia" },
            "5": { "name": "keyword.operator.assignment.pactia" },
            "6": { "name": "constant.numeric.pactia" }
          }
        },
        {
          "match": "^(\\s*)((?:export)\\s+)?(def)\\s+([\\w]+)\\s*(=)",
          "captures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "keyword.declaration.pactia" },
            "4": { "name": "variable.other.constant.pactia" },
            "5": { "name": "keyword.operator.assignment.pactia" }
          }
        }
      ]
    },
    "def-field-specs": {
      "patterns": [
        {
          "match": "^(\\s*)\\b(modifier)\\s*,\\s*$",
          "captures": {
            "2": { "name": "constant.language.def-spec.pactia" }
          }
        }
      ]
    },
    "object-value-blocks": {
      "patterns": [
        {
          "begin": "^(\\s*)([A-Z][A-Z0-9_]*):\\s*\\{\\s*$",
          "beginCaptures": {
            "2": { "name": "constant.other.env-key.pactia" }
          },
          "end": "^(\\1)\\}(?:,)?\\s*$",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#block-content" }
          ]
        },
        {
          "begin": "^(\\s*)([A-Za-z][\\w.]*):\\s*\\{\\s*$",
          "beginCaptures": {
            "2": { "name": "meta.object.key.pactia" }
          },
          "end": "^(\\1)\\}(?:,)?\\s*$",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#block-content" }
          ]
        }
      ]
    },
    "inline-tag-modifiers": {
      "patterns": [
        {
          "begin": "(@)(?:(\\w+)::)?(\\w+)(?:\\s+([\\w.-]+))?\\s*(\\{)(?=[^{}]*\\})",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.namespace.pactia" },
            "3": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function modifier" },
            "4": { "name": "entity.name.tag.target.pactia" },
            "5": { "name": "punctuation.section.block.begin.pactia" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#inline-block-content" }
          ]
        }
      ]
    },
    "inline-objects": {
      "patterns": [
        {
          "begin": "(\\{)(?=[^{}]*\\})(?!\\s*@@?\\w)",
          "beginCaptures": {
            "1": { "name": "punctuation.section.braces.begin.pactia" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.braces.end.pactia" }
          },
          "patterns": [
            { "include": "#inline-object-content" }
          ]
        }
      ]
    },
    "export-blocks": {
      "patterns": [
        {
          "begin": "^(\\s*)(export)\\s+(model|module|service)\\s+(\\w+)\\s*\\{\\s*$",
          "beginCaptures": {
            "2": { "name": "keyword.declaration.pactia" },
            "3": { "name": "keyword.declaration.pactia" },
            "4": { "name": "entity.name.type.pactia" }
          },
          "end": "^(\\1)\\}(?:,)?\\s*$",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#block-content" }
          ]
        }
      ]
    },
    "modifier-tag-lines": {
      "patterns": [
        {
          "match": "^(\\s*)(@@)([\\w]+)(?:\\(([^)]+)\\))?\\s*$",
          "captures": {
            "2": { "name": "punctuation.definition.modifier.pactia punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "3": { "name": "entity.name.tag.modifier.pactia entity.name.function.macro entity.name.function modifier" },
            "4": { "name": "entity.name.type.pactia" }
          }
        },
        {
          "match": "^(\\s*)(@@)([\\w]+)(?:\\(([^)]+)\\))?\\s+([A-Za-z][\\w]*)",
          "captures": {
            "2": { "name": "punctuation.definition.modifier.pactia punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "3": { "name": "entity.name.tag.modifier.pactia entity.name.function.macro entity.name.function modifier" },
            "4": { "name": "entity.name.type.pactia" },
            "5": { "name": "entity.name.type.pactia" }
          }
        }
      ]
    },
    "modifier-tags": {
      "patterns": [
        {
          "match": "(@@)([\\w]+)(?:\\(([^)]+)\\))?",
          "captures": {
            "1": { "name": "punctuation.definition.modifier.pactia punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.tag.modifier.pactia entity.name.function.macro entity.name.function modifier" },
            "3": { "name": "entity.name.type.pactia" }
          }
        }
      ]
    },
    "modifier-flags": {
      "patterns": [
        {
          "match": "(?<!@)(@)(pk|unique|index|nullable|pii|public|optional)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function modifier.flag" }
          }
        }
      ]
    },
    "host-tag-prefix": {
      "patterns": [
        {
          "match": "^(\\s*)(@)([\\w]+)(?:\\s+([A-Z][\\w]*)|\\(([\\w]+)\\))\\s*,?\\s*$",
          "captures": {
            "2": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "3": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function" },
            "4": { "name": "entity.name.type.pactia" },
            "5": { "name": "entity.name.type.pactia" }
          }
        }
      ]
    },
    "modifier-shorthands": {
      "patterns": [
        {
          "match": "(@)(output|input|auth|returns|body)\\s+([A-Z][\\w]*)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function modifier.shorthand" },
            "3": { "name": "entity.name.type.pactia" }
          }
        },
        {
          "match": "(@)(status)\\s+(\\d+)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function modifier.shorthand" },
            "3": { "name": "constant.numeric.pactia" }
          }
        },
        {
          "begin": "(@)(throws)\\s*(\\{)(?=[^{}]*\\})",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function modifier.shorthand" },
            "3": { "name": "punctuation.section.block.begin.pactia" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.block.end.pactia" }
          },
          "patterns": [
            { "include": "#inline-object-content" }
          ]
        },
        {
          "match": "(@)(emit)\\s+([\\w.]+)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
            "2": { "name": "entity.name.tag.clause.pactia entity.name.function.macro entity.name.function modifier.shorthand" },
            "3": { "name": "variable.other.event.pactia" }
          }
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "match": "^(\\s*)(#)(?!\\[)([\\w-]+)(\\()([^)]*)(\\))\\s*,?\\s*$",
          "captures": {
            "2": { "name": "punctuation.definition.macro.pactia" },
            "3": { "name": "entity.name.function.macro.pactia entity.name.function" },
            "4": { "name": "punctuation.definition.macro.pactia" },
            "5": { "name": "variable.parameter.macro.pactia" },
            "6": { "name": "punctuation.definition.macro.pactia" }
          }
        },
        {
          "match": "^(\\s*)(#)(?!\\[)([\\w-]+)\\s*,?\\s*$",
          "captures": {
            "2": { "name": "punctuation.definition.macro.pactia" },
            "3": { "name": "entity.name.function.macro.pactia entity.name.function" }
          }
        }
      ]
    },
    "package-imports": {
      "patterns": [
        {
          "begin": "^(import)(\\s+)(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.pactia" },
            "3": { "name": "punctuation.section.braces.begin.pactia" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.braces.end.pactia" }
          },
          "patterns": [
            {
              "match": "(@@)([\\w]+)",
              "captures": {
                "1": { "name": "punctuation.definition.modifier.pactia punctuation.definition.tag.pactia punctuation.definition.macro.pactia" },
                "2": { "name": "entity.name.tag.modifier.pactia entity.name.function.macro.pactia entity.name.function" }
              }
            },
            {
              "match": "(@)([\\w]+)",
              "captures": {
                "1": { "name": "punctuation.definition.tag.pactia" },
                "2": { "name": "entity.name.tag.clause.pactia" }
              }
            },
            {
              "match": "(#)([\\w-]+)",
              "captures": {
                "1": { "name": "punctuation.definition.macro.pactia" },
                "2": { "name": "entity.name.function.macro.pactia entity.name.function" }
              }
            },
            {
              "match": "[A-Za-z_][\\w]*",
              "name": "variable.other.import.pactia"
            }
          ]
        },
        {
          "match": "^(import)(\\s+)(@)([\\w-]+/[\\w.-]+)(\\s*;)",
          "captures": {
            "1": { "name": "keyword.control.import.pactia" },
            "3": { "name": "punctuation.definition.tag.pactia" },
            "4": { "name": "entity.name.tag.package.pactia" }
          }
        },
        {
          "match": "(from)(\\s+)(@)([\\w-]+/[\\w.-]+)(\\s*;)?",
          "captures": {
            "1": { "name": "keyword.control.import.pactia" },
            "3": { "name": "punctuation.definition.tag.pactia" },
            "4": { "name": "entity.name.tag.package.pactia" }
          }
        },
        {
          "match": "(from)(\\s+)(\\.\\.?/[\\w./-]+)(\\s*;)?",
          "captures": {
            "1": { "name": "keyword.control.import.pactia" },
            "3": { "name": "string.unquoted.path.pactia" }
          }
        },
        {
          "match": "\\b(import|from)\\b",
          "name": "keyword.control.import.pactia"
        },
        {
          "match": "(@)([\\w-]+/[\\w-]+)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.pactia" },
            "2": { "name": "entity.name.tag.package.pactia" }
          }
        },
        {
          "match": "\"\\^[0-9]+(?:\\.[0-9]+)*\"",
          "name": "constant.numeric.semver-range.pactia"
        },
        {
          "match": "\\^[0-9]+(?:\\.[0-9]+)*",
          "name": "constant.numeric.semver-range.pactia"
        }
      ]
    },
    "prose-lines": {
      "begin": "^(\\s*)(>\\s*)",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.prose.quote.pactia punctuation.definition.blockquote" }
      },
      "end": "$",
      "patterns": [
        { "include": "#interpolation" },
        {
          "match": "[^$]+",
          "name": "string.unquoted.prose.pactia string.quoted.other markup.italic"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(pactia)\\s+([0-9]+(?:\\.[0-9]+)?)",
          "captures": {
            "1": { "name": "keyword.other.version.pactia" },
            "2": { "name": "constant.numeric.language-version.pactia" }
          }
        },
        {
          "match": "\\b(pactia|product|module|service|model|context|import|export|def|in)\\b",
          "name": "keyword.declaration.pactia"
        },
        {
          "match": "\\b(GET|POST|PUT|PATCH|DELETE)\\b",
          "name": "keyword.control.http.pactia"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.pactia"
        },
        {
          "match": "\\b(method|path|role|capabilities|values|to|verb|cardinality|entity|transitions|slos|macros|auth|returns|status|emit|errors|direction|maps_to|payload|handler|statement|name|when|then|on|depends_on|residency|scenarios|coverage|replicas|region|version|mode|secret|required|default|description|type|env|names|roles|retain|period|reason|code|message|target|metric|tab|level|provider|service|id|pagination|max_page|bodyRef|summary|platform|screen|route)\\b",
          "name": "keyword.other.assignment.pactia"
        }
      ]
    },
    "assignment-keys": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Z0-9_]*)(?=\\s*:)",
          "name": "constant.other.env-key.pactia"
        },
        {
          "match": "\\b([\\w]+)(?=\\s*:)",
          "name": "meta.object.key.pactia"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(uuid|string|decimal|boolean|datetime|json|integer|int|float|void)\\b",
          "name": "support.type.primitive.pactia"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.pactia"
        }
      ]
    },
    "numbers": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.pactia"
    }
  }
}

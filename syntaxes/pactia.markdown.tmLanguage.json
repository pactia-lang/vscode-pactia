{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "markdown.pactia.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#pactia-code-block"
    }
  ],
  "repository": {
    "pactia-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,})(?:\\s*)(pactia)(?:\\s*)$",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        }
      },
      "end": "(^|\\G)(\\s*)(\\3)(?:\\s*)$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "meta.embedded.block.pactia",
      "patterns": [
        {
          "begin": "(^|\\G)(?!\\s*```)",
          "while": "(^|\\G)(?!\\s*```)",
          "patterns": [
            {
              "include": "source.pactia"
            }
          ]
        }
      ]
    }
  }
}
